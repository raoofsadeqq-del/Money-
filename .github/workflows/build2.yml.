name: Build APK
on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip project
        run: unzip -q FinanceApp.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Build debug APK
        working-directory: FinanceApp
        run: |
          set +e
          gradle assembleDebug --no-daemon --console=plain > build.log 2>&1
          code=$?
          if [ $code -ne 0 ]; then
            { grep "^e: " build.log | head -8; grep -A4 "What went wrong" build.log | head -8; } | while IFS= read -r l; do echo "::error::$l"; done
          fi
          exit $code
      - run: cp FinanceApp/app/build/outputs/apk/debug/app-debug.apk MyFinance.apk
      - uses: actions/upload-artifact@v4
        with:
          name: MyFinance-APK
          path: MyFinance.apk
      - name: Publish release (tags only)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: MyFinance.apk
